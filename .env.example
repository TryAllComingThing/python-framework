APP_ENV=local
LOG_LEVEL=INFO
DEFAULT_LOCALE=zh-CN
FILE_STORAGE_ROOT=./var/uploads
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/system_foundation
# CORS_ORIGINS=["http://localhost:5173"]
# TRUSTED_HOSTS=["localhost","127.0.0.1"]
COOKIE_AUTH_ENABLED=false
SESSION_TTL_HOURS=8
# CSRF_ORIGINS=["http://localhost:5173"]
# Enable cookie auth only after configuring CSRF_ORIGINS and PostgreSQL
MAX_REQUEST_BYTES=10485760
FILE_MAX_BYTES=5000000

# Set true only with a healthy local clamd service; scanner failures reject uploads.
FILE_MALWARE_SCAN_ENABLED=false
FILE_CLAMD_SOCKET=/run/clamav/clamd.ctl
